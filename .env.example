# Bun's built-in sqlite driver reads this file path (defaults to ./pokedoro.db if unset)
DATABASE_PATH=pokedoro.db

# Resend API key used to send OTP sign-in emails.
# If unset, OTP codes are logged to the server console instead of emailed (dev fallback).
RESEND_API_KEY=

# From-address used when sending OTP emails (must be a verified Resend sender/domain in production)
OTP_FROM_EMAIL="Pokedoro <onboarding@resend.dev>"

# Secret key used to pepper (HMAC) stored OTP codes before hashing them.
# Required in production (the server throws if unset); falls back to a fixed
# insecure dev key otherwise. Generate with: openssl rand -hex 32
OTP_SECRET=
